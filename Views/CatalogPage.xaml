<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldSalesForce.Views.CatalogPage"
             x:Name="PageRoot"
             Title="Catálogo">
    <VerticalStackLayout Padding="16" Spacing="16">
        <Label Text="Catálogo de Productos" FontAttributes="Bold" FontSize="24" />
        <SearchBar Text="{Binding SearchText}" Placeholder="Buscar producto..." />
        <Picker Title="Categoría" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />

        <CollectionView ItemsSource="{Binding Products}" SelectionMode="Single" SelectedItem="{Binding SelectedProduct, Mode=TwoWay}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="12" Margin="0,4" CornerRadius="12" BorderColor="LightGray">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding Category}" FontSize="12" TextColor="Gray" />
                            <Label Text="{Binding Description}" LineBreakMode="WordWrap" MaxLines="2" />
                            <Label Text="{Binding Price, StringFormat='Precio: {0:C}'}" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
