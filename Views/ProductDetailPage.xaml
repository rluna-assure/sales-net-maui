<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FieldSalesForce.Views.ProductDetailPage"
             x:Name="PageRoot"
             Title="Detalle de producto">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
            <Label Text="{Binding Product.Name}" FontAttributes="Bold" FontSize="28" />
            <Label Text="{Binding Product.Category}" FontSize="14" TextColor="Gray" />
            <Label Text="{Binding Product.Description}" FontSize="16" />
            <Label Text="{Binding Product.Price, StringFormat='Precio: {0:C}'}" FontSize="20" FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                <Label Text="Cantidad" VerticalOptions="Center" />
                <Stepper Minimum="1" Maximum="100" Value="{Binding Quantity, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}" />
                <Label Text="{Binding Quantity}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Button Text="Agregar al carrito" Command="{Binding AddToCartCommand}" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
