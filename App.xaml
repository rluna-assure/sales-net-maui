<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:FieldSalesForce.Helpers"
             xmlns:local="clr-namespace:FieldSalesForce"
             x:Class="FieldSalesForce.App">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:StringToBoolConverter x:Key="StringToBoolConverter" />
            <helpers:IntToDoubleConverter x:Key="IntToDoubleConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
